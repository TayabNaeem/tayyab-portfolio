rules_version = '2';

// Firestore security rules for the portfolio contact form.
//
// These allow ANYONE to submit a message (create a doc in `contacts`) but
// nobody to read, edit, or delete them from the client. You read submissions
// in the Firebase Console (the console bypasses these rules).
//
// Paste this into: Firebase Console -> Firestore Database -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    match /contacts/{docId} {
      allow create: if
        // Only these exact fields are allowed
        request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        // name
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        // email (basic shape check)
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        // message
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;

      // Submissions are private: no client reads/updates/deletes.
      allow read, update, delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
