# Copy the names below into Vercel → Project → Settings → Environment Variables,
# and into .env.local for local testing. Never commit real values, and never put
# a secret in a NEXT_PUBLIC_* variable — those are bundled into the browser build.

# Public read URL for the Backblaze B2 bucket holding screenshots and logos.
# Not a secret.
NEXT_PUBLIC_ASSET_BASE=https://f005.backblazeb2.com/file/Tayyab-Portfolio

# --- Chat widget email notifications ---------------------------------------
# API key from https://resend.com (Dashboard → API Keys). SECRET.
# Without it the chat still works, but no email is sent.
RESEND_API_KEY=

# Where leads land. Defaults to naemtayb@gmail.com if unset.
LEAD_TO_EMAIL=naemtayb@gmail.com

# Sender address. Must be on a domain verified in Resend.
# Resend's shared onboarding@resend.dev only delivers to your own account email,
# so verify a domain before relying on this in production.
LEAD_FROM_EMAIL=Portfolio <onboarding@resend.dev>
