# Copy the names below into Vercel → Project → Settings → Environment Variables,
# and into .env.local for local testing. Never commit real values, and never put
# a secret in a NEXT_PUBLIC_* variable — those are bundled into the browser build
# and readable by every visitor.

# Public read URL for the Backblaze B2 bucket holding screenshots and logos.
# Not a secret.
NEXT_PUBLIC_ASSET_BASE=https://f005.backblazeb2.com/file/Tayyab-Portfolio

# --- Chat widget email notifications (SMTP) ---------------------------------
# Without these the chat still works, it just sends no email.

# Gmail:    smtp.gmail.com          Zoho:  smtp.zoho.com
# Outlook:  smtp-mail.outlook.com   cPanel/hosting: usually mail.yourdomain.com
SMTP_HOST=smtp.gmail.com

# 587 for STARTTLS (the usual choice), 465 for implicit TLS.
SMTP_PORT=587

# The mailbox being logged into.
SMTP_USER=naemtayb@gmail.com

# SECRET. For Gmail this must be a 16 character App Password, not the account
# password: Google Account → Security → 2-Step Verification → App passwords.
# Normal passwords are rejected on Gmail SMTP.
SMTP_PASS=

# Optional. Left unset it is inferred from the port (true for 465, else false).
# SMTP_SECURE=false

# Where leads land. Defaults to naemtayb@gmail.com.
LEAD_TO_EMAIL=naemtayb@gmail.com

# The From header. Defaults to SMTP_USER. Most providers require this to match
# the authenticated mailbox, or they rewrite or reject it.
LEAD_FROM_EMAIL=Portfolio <naemtayb@gmail.com>
